# Ejemplo de variables de entorno. Copiar a .env y ajustar valores.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=sigesp_db_manager

# A6: usar un valor FUERTE y único. Generar con: openssl rand -hex 32
JWT_SECRET=change_me_to_a_strong_random_value
# A5/A6: secreto distinto para refresh tokens (openssl rand -hex 32)
JWT_REFRESH_SECRET=change_me_to_another_strong_random_value

# A5: tiempos de vida de los tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Origen permitido para CORS (separado por comas). Requerido si se usan cookies de sesión.
CORS_ORIGIN=http://localhost:4200

# Opciones de la cookie HttpOnly del refresh token (opción c).
# Dev (mismo equipo, distinto puerto = same-site): lax + false.
# Producción (cross-site): none + true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
